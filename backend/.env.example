# ============================================================
# Gainz Backend — Variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# ============================================================

# ─── Servidor ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────
# Orígenes permitidos, separados por comas. Vacío = cualquier origen
# (solo aceptable en desarrollo local).
CORS_ORIGINS=

# ─── Base de datos MySQL ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fitness_tracker
DB_USER=root
DB_PASSWORD=tu_password

# ─── Firebase Admin (autenticación) ──────────────────────────
# DEJAR EN BLANCO para activar el modo DEV (sin auth real,
# usa user id=1 automáticamente). Rellena para producción.
#
# El modo DEV solo funciona con NODE_ENV distinto de "production": en
# producción, si faltan estas credenciales el servidor rechaza todas las
# peticiones en lugar de dejarlas pasar sin autenticar.
#
# Obtén las credenciales en Firebase Console → Project Settings
# → Service Accounts → Generate New Private Key.
# El privateKey debe ir entre comillas dobles con \n literales.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
