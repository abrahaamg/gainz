# ============================================================
# Gainz Frontend — Variables de entorno (Vite)
# Copia este archivo a `.env` y rellena los valores reales.
# Todas las vars deben empezar por VITE_ para ser accesibles
# desde el código (import.meta.env.VITE_*).
# ============================================================

# ─── API Backend ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api/v1

# ─── Firebase Client (autenticación) ─────────────────────────
# DEJAR EN BLANCO para activar el modo DEV (login/registro
# directos al onboarding sin auth real, useAuthInit carga
# automáticamente al usuario id=1). Rellena para producción.
#
# Obtén las credenciales en Firebase Console → Project Settings
# → General → Tu app web → Configuración SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
